<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeFrameworkVersion>9.0.7</RuntimeFrameworkVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2Dir)/data_sts2_windows_x86_64/sts2.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2Dir)/data_sts2_windows_x86_64/GodotSharp.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2Dir)/data_sts2_windows_x86_64/0Harmony.dll" />
    <PackageReference Include="Mono.Cecil" Version="0.11.4" />
  </ItemGroup>
</Project>
